{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/health", "dest": "/api/index.py" },
    { "src": "/predict", "dest": "/api/index.py" },
    { "src": "/predict/(.*)", "dest": "/api/index.py" },
    { "src": "/schema", "dest": "/api/index.py" },
    { "src": "/metrics", "dest": "/api/index.py" },
    { "src": "/samples", "dest": "/api/index.py" },
    { "src": "/model-info", "dest": "/api/index.py" },
    { "src": "/docs", "dest": "/api/index.py" },
    { "src": "/openapi.json", "dest": "/api/index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/dist/index.html" }
  ]
}
